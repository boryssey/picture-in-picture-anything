{
  "name": "picture-in-picture-anything-chrome-extension",
  "version": "1.1.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "pnpm build:chrome && pnpm build:firefox",
    "build:chrome": "BROWSER=chrome webpack",
    "build:firefox": "BROWSER=firefox webpack",
    "build:analyze": "ANALYZE=true BROWSER=chrome webpack",
    "dev": "node scripts/server.js",
    "dev:firefox": "pnpm build:firefox && concurrently -k -n webpack,web-ext -c blue,magenta \"pnpm firefox:watch\" \"pnpm firefox:run\"",
    "check:types": "tsgo --noEmit",
    "check:types-classic": "tsc --noEmit",
    "firefox:watch": "BROWSER=firefox webpack --watch",
    "firefox:run": "web-ext run -s dist/firefox -p=default-release",
    "firefox:lint": "web-ext lint -s dist/firefox",
    "package:firefox": "pnpm build:firefox && web-ext build -s dist/firefox -a web-ext-artifacts --overwrite-dest",
    "package:chrome": "pnpm build:chrome && zip -r pip-anything-extension-chrome.zip dist/chrome",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=22.15.0"
  },
  "packageManager": "pnpm@11.10.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/lodash": "^4.17.7",
    "@types/node": "^24.13.2",
    "@types/webextension-polyfill": "^0.12.5",
    "@typescript/native-preview": "7.0.0-dev.20260705.1",
    "clean-webpack-plugin": "^4.0.0",
    "concurrently": "^10.0.3",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.2",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.2.1",
    "fs-extra": "^11.2.0",
    "globals": "^17.7.0",
    "html-loader": "^5.0.0",
    "html-webpack-plugin": "^5.6.0",
    "new-javascript": "^0.4.7",
    "ssestream": "^1.1.0",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.3.10",
    "ts-loader": "^9.6.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.62.1",
    "web-ext": "^10.4.0",
    "webpack": "^5.101.0",
    "webpack-bundle-analyzer": "^5.3.0",
    "webpack-cli": "^7.2.1",
    "webpack-dev-server": "^6.0.0"
  },
  "dependencies": {
    "lodash": "^4.17.21",
    "webextension-polyfill": "^0.12.0"
  }
}
